GDSII_STREAM_VERSION 6.0

LIBRARY "ETVP_SiPhoton_CoreX" 0.0 0.0 1e-9

STRUCTURE "TOP_CELL"
{
  // ============================================================
  // СЛОЙ 0: Si₃N₄ волноводы и кольцевые резонаторы (256 шт.)
  // Технология: 220 nm SOI, толщина Si₃N₄ = 400 nm
  // ============================================================
  
  // --- Базовые параметры ---
  LAMBDA = 1550e-9          // м
  R_MIN = 10e-6             // м (минимальный радиус кольца)
  R_MAX = 80e-6             // м
  WAVEGUIDE_WIDTH = 0.5e-6  // м (ширина волновода)
  GAP = 0.2e-6              // м (зазор между волноводом и кольцом)
  
  // --- Генерация 256 колец (радиусы по Phi, шаг 1/16) ---
  FOR i = 0 TO 255:
  {
    // Расчёт радиуса
    R = R_MIN * (1.618^(i/16.0))
    // Координаты (архимедова спираль для компактности)
    THETA = i * 0.05
    X = 500e-6 + 15e-6 * i * COS(THETA)
    Y = 500e-6 + 15e-6 * i * SIN(THETA)
    
    // Кольцо (слой 0)
    LAYER = 0  DATATYPE = 0
    RING X = X Y = Y RADIUS = R WIDTH = WAVEGUIDE_WIDTH
    
    // Прямой волновод (связь) — касательный к кольцу
    ANGLE = THETA + PI/2
    WAVEGUIDE X1 = X - 10e-6*COS(ANGLE) Y1 = Y - 10e-6*SIN(ANGLE)
              X2 = X + 10e-6*COS(ANGLE) Y2 = Y + 10e-6*SIN(ANGLE)
              WIDTH = WAVEGUIDE_WIDTH
  }

  // ============================================================
  // СЛОЙ 1: pn-переходы (поликремний) для модуляции C
  // Технология: поли-Si 200 nm, легирование имплантацией
  // ============================================================
  
  FOR i = 0 TO 255:
  {
    THETA = i * 0.05
    X = 500e-6 + 15e-6 * i * COS(THETA)
    Y = 500e-6 + 15e-6 * i * SIN(THETA)
    
    // pn-переход — резистивный нагреватель (спираль)
    LAYER = 1  DATATYPE = 0
    SPIRAL X = X + 0.3e-6  Y = Y + 0.3e-6
           WIDTH = 0.2e-6  SPACING = 0.2e-6  TURNS = 3
           INNER_RADIUS = R + WAVEGUIDE_WIDTH + GAP
           OUTER_RADIUS = R + WAVEGUIDE_WIDTH + GAP + 2e-6
  }

  // ============================================================
  // СЛОЙ 2: Джозефсоновские параметрические усилители (JPA)
  // Технология: Al / Al₂O₃ (сверхпроводящие), переходы Джозефсона
  // ============================================================
  
  // Массив 8x8 JPA (64 штуки), встроенных в зазоры между кольцами
  FOR j = 0 TO 7:
  {
    FOR k = 0 TO 7:
    {
      // Центры JPA — в узлах сетки между кольцами
      X_JPA = 100e-6 + j * 100e-6
      Y_JPA = 100e-6 + k * 100e-6
      
      // Копланарный резонатор (четвертьволновый, 6 ГГц)
      LAYER = 2  DATATYPE = 0
      CPW X = X_JPA  Y = Y_JPA
          LENGTH = 12e-6           // 6 ГГц на Si
          CENTER_WIDTH = 3e-6
          GAP_WIDTH = 1.5e-6
      
      // Джозефсоновский переход (мостик)
      LAYER = 2  DATATYPE = 1
      JUNCTION X = X_JPA + 6e-6  Y = Y_JPA - 3e-6
              SIZE = 0.3e-6 x 0.3e-6
    }
  }

  // ============================================================
  // СЛОЙ 3: MEMS-переключатель + спиральный шлейф (память)
  // Технология: поли-Si 1 мкм (MEMS) + Si₃N₄ спираль
  // ============================================================
  
  // --- Спиральный шлейф задержки (10 см на кристалле) ---
  LAYER = 0  DATATYPE = 0    // Si₃N₄
  SPIRAL START = (800e-6, 800e-6)
         LENGTH = 0.1        // 10 см
         WIDTH = 1e-6
         SPACING = 2e-6
         TURNS = 250         // 250 витков, компактная упаковка
  
  // --- MEMS-переключатель (на входе в шлейф) ---
  LAYER = 3  DATATYPE = 0    // поли-Si слой
  MEMS_BEAM X1 = 780e-6  Y1 = 800e-6
           X2 = 820e-6  Y2 = 800e-6
           WIDTH = 2e-6
           HEIGHT = 10e-6     // длина кантилеввера
           GAP_VERTICAL = 0.5e-6  // до нижнего электрода
  
  // Нижний электрод для электростатического привода
  LAYER = 3  DATATYPE = 1    // Al
  ELECTRODE X = 800e-6  Y = 790e-6
           WIDTH = 10e-6  HEIGHT = 5e-6

  // ============================================================
  // КОНТАКТНЫЕ ПЛОЩАДКИ (для бондинга)
  // ============================================================
  
  // Входной лазерный порт
  LAYER = 0  DATATYPE = 0
  WAVEGUIDE X1 = 0  Y1 = 500e-6  X2 = 50e-6  Y2 = 500e-6
  GRATING_COUPLER X = 0  Y = 500e-6  PERIOD = 0.63e-6
  
  // Выходной порт (к детекторам)
  WAVEGUIDE X1 = 950e-6  Y1 = 500e-6  X2 = 1000e-6  Y2 = 500e-6
  GRATING_COUPLER X = 1000e-6  Y = 500e-6  PERIOD = 0.63e-6
  
  // Контакты для JPA (смещение накачки)
  LAYER = 2  DATATYPE = 2
  PAD X = 50e-6  Y = 50e-6  SIZE = 100e-6 x 100e-6  // V_bias
  
  // Контакты для pn-переходов (управление C)
  LAYER = 1  DATATYPE = 1
  PAD X = 50e-6  Y = 950e-6  SIZE = 100e-6 x 100e-6  // V_control
}

ENDLIB
